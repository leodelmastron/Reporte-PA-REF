    {t:"18:00–19:30",r:3,d:[57,100]},{t:"19:30–21:00",r:3,d:[62,100]},
    {t:"21:00–22:30",r:3,d:[60,100]},{t:"22:30–00:00",r:3,d:[52,100]}
  ];
  var W=[
    {t:"06:00–07:30",r:3,d:[21,150]},{t:"07:30–09:00",r:3,d:[9,150]},
    {t:"09:00–10:30",r:3,d:[26,150]},{t:"10:30–12:00",r:3,d:[28,150]},
    {t:"12:00–13:30",r:3,d:[17,150]},
    {t:"14:30–16:00",r:3,d:[43,150]},{t:"16:00–17:30",r:3,d:[62,150]},
    {t:"17:30–19:00",r:3,d:[55,150]},{t:"19:00–20:30",r:3,d:[10,150]},
    {t:"20:30–22:00",r:3,d:[17,150]}
  ];
  var A=[
    {t:"06:00–07:30",r:3,d:[5,50]},{t:"07:30–09:00",r:3,d:[3,50]},
    {t:"09:00–10:30",r:3,d:[19,50]},{t:"10:30–12:00",r:3,d:[21,50]},
    {t:"12:00–13:30",r:3,d:[7,50]},
    {t:"14:30–16:00",r:3,d:[17,50]},{t:"16:00–17:30",r:3,d:[10,50]},
    {t:"17:30–19:00",r:3,d:[12,50]},{t:"19:00–20:30",r:3,d:[5,50]},
    {t:"20:30–22:00",r:3,d:[2,50]}
  ];
  var T=[
    {t:"06:00–07:00",r:2,d:[2,50]},{t:"07:00–08:00",r:2,d:[2,50]},
    {t:"08:00–09:00",r:2,d:[5,50]},{t:"09:00–10:00",r:2,d:[17,50]},
    {t:"10:00–11:00",r:2,d:[14,50]},{t:"11:00–12:00",r:2,d:[7,50]},
    {t:"12:00–13:00",r:2,d:[14,50]},{t:"13:00–14:00",r:2,d:[5,50]},
    {t:"14:00–15:00",r:2,d:[2,50]},{t:"15:00–16:00",r:2,d:[17,50]},
    {t:"16:00–17:00",r:2,d:[7,50]},{t:"17:00–18:00",r:2,d:[26,50]},
    {t:"18:00–19:00",r:2,d:[7,50]},{t:"19:00–20:00",r:2,d:[5,50]},
    {t:"20:00–21:00",r:2,d:[2,50]},{t:"21:00–22:00",r:2,d:[2,30]}
  ];
  function allP(a){return a.map(function(s){return s.d[1]>0?s.d[0]/s.d[1]*100:0;});}
  function perc(a,p){var s=[...a].sort(function(x,y){return x-y;});return s[Math.floor(s.length*p/100)]||0;}
  var p40c=perc(allP(C),40),p70c=perc(allP(C),70);
  var p40w=perc(allP(W),40),p70w=perc(allP(W),70);
  var p40a=perc(allP(A),40),p70a=perc(allP(A),70);
  var p40t=perc(allP(T),40),p70t=perc(allP(T),70);
  function colr(pct,p40,p70){
    if(pct>=p70)return{bg:"#C8EDD9",fg:"#085041"};
    if(pct>=p40)return{bg:"#FDEBD0",fg:"#8B4500"};
    return{bg:"#FDDCDC",fg:"#A32D2D"};
  }
  function mkCell(slot,p40,p70){
    var pct=slot.d[1]>0?slot.d[0]/slot.d[1]*100:0;
    var c=colr(pct,p40,p70);
    return'<td rowspan="'+slot.r+'" style="background:'+c.bg+';color:'+c.fg+';text-align:center;font-weight:700;padding:6px 4px;font-size:11px;border:.5px solid rgba(255,255,255,.5)">'+Math.round(pct)+'%</td>';
  }
  // Build grid: 36 rows × services
  // Each service has an array of slots; render as rowspan cells
  function buildCol(slots,p40,p70,totalRows){
    var cells=Array(totalRows).fill(null);
    var row=0;
    slots.forEach(function(s){if(row<totalRows){cells[row]={slot:s,p40:p40,p70:p70};row+=s.r;}});
    return cells;
  }
  var NROWS=36;
  var cCells=showPA?buildCol(C,p40c,p70c,NROWS):null;
  var wCells=showRF?buildCol(W,p40w,p70w,NROWS):null;
  var aCells=showRF?buildCol(A,p40a,p70a,NROWS):null;
  var tCells=showRF?buildCol(T,p40t,p70t,NROWS):null;
  // Row labels every 30 min from 6:00
  function rowLabel(ri){var t=6*60+ri*30;var h=Math.floor(t/60),m=t%60;return h+":"+(m===0?"00":"30");}

  var out='<div style="overflow-x:auto"><table class="hmap" style="min-width:350px"><thead><tr>'+
    '<th style="text-align:left;padding:5px 8px;min-width:60px">Horario</th>'+
    (showPA?'<th style="min-width:90px">Canchas</th>':'')+
    (showRF?'<th style="min-width:85px">Wellness</th>':'')+
    (showRF?'<th style="min-width:85px">Alto Rend.</th>':'')+
    (showRF?'<th style="min-width:85px">Terapia</th>':'')+
    '</tr></thead><tbody>';

  for(var ri=0;ri<NROWS;ri++){
    out+='<tr>';
    out+='<td style="padding:2px 8px;font-size:10px;color:var(--muted);white-space:nowrap;border-right:.5px solid var(--border)">'+rowLabel(ri)+'</td>';
    if(showPA&&cCells[ri])  out+=mkCell(cCells[ri].slot,p40c,p70c);
    if(showRF&&wCells[ri])  out+=mkCell(wCells[ri].slot,p40w,p70w);
    if(showRF&&aCells[ri])  out+=mkCell(aCells[ri].slot,p40a,p70a);
    if(showRF&&tCells[ri])  out+=mkCell(tCells[ri].slot,p40t,p70t);
    out+='</tr>';
  }
  out+='</tbody></table></div>'+
    '<p style="font-size:10px;color:var(--muted);margin-top:8px">'+
    '<span style="display:inline-block;width:10px;height:10px;background:#C8EDD9;border-radius:2px;margin-right:4px"></span>≥70° perc. &nbsp;'+
    '<span style="display:inline-block;width:10px;height:10px;background:#FDEBD0;border-radius:2px;margin-right:4px"></span>40–70° perc. &nbsp;'+
    '<span style="display:inline-block;width:10px;height:10px;background:#FDDCDC;border-radius:2px;margin-right:4px"></span>&lt;40° perc. &nbsp;·  Canchas: turnos 90 min · Wellness/AR: 90 min (pausa 13:30–14:30) · Terapia: 60 min</p>';
  var hm=document.getElementById("heatmap-wrap");if(hm)hm.innerHTML=out;
}

