// ── Heatmap renderer — grouped slots (rowspan) ───────────────────────
function renderHeatmap(showPA,showRF){
  var C=[
    {t:"06:00–07:30",r:3,d:[10,100]},{t:"07:30–09:00",r:3,d:[14,100]},
