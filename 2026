    }
  } else {
    const ari=ARI[date]||{};const diff=IZIPAY_DIFF[date]||0;const diffC=IZIPAY_DIFF_COM[date]||0;
    if(ari.cancha||diff) rows.push({p:"Alquiler de Canchas",e:"Padel Arena",ing:(ari.cancha||0)+(diff*0.80),com:-((ari.cancha||0)*POSCOM_IZI)+(diffC*0.80)});
