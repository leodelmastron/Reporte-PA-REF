    if(ari.wellness_ari) rows.push({p:"Wellness",e:"Reform",ing:ari.wellness_ari,com:-(ari.wellness_ari*POSCOM_IZI)});
    if(ari.terapia_ari)  rows.push({p:"Terapia",e:"Reform",ing:ari.terapia_ari,com:-(ari.terapia_ari*POSCOM_IZI)});
    if(ari.ar_ari)       rows.push({p:"Alto Rendimiento",e:"Reform",ing:ari.ar_ari,com:-(ari.ar_ari*POSCOM_IZI)});
  }
