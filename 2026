    if(rr.reform_renta) rows.push({p:"Renta Reform",e:"Padel Arena",ing:rr.reform_renta,com:0});
    if(rr.memb_black)   rows.push({p:"Membresías Black",e:"Padel Arena",ing:rr.memb_black,com:0});
  }
  // Torneo
  if(TORNEO_AMT[date]) rows.push({p:"Alquiler de Canchas",e:"Padel Arena",ing:TORNEO_AMT[date],com:0,isTorneo:true});
  // MP
  MP.filter(m=>m.date===date).forEach(m=>rows.push({p:m.p,e:m.e,ing:m.ing,com:m.com,isMP:m.isMP}));
  // Rentas + membresías on May 31
  if(date==="2026-05-31"){
    RENTAS_LIST.forEach(r=>rows.push(r));
    MEMBRESIAS.forEach(r=>rows.push(r));
  }
  return rows;
}

