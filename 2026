  const ntEl=document.getElementById("nt");if(ntEl)ntEl.textContent=total+" respuestas";
  const npEl=document.getElementById("np");if(npEl)npEl.textContent="Promotores: "+promo;
  const ndetEl=document.getElementById("ndet");if(ndetEl)ndetEl.textContent="Detractores: "+detr;
  // Bars
  const nbars=document.getElementById("nbars");
  if(nbars){
    let bh="";
    for(let k=10;k>=1;k--){
      const v=dist[k]||0;const pct=total>0?v/total*100:0;
      const col=k>=9?"#1D9E75":k>=7?"#BA7517":"#A32D2D";
      bh+='<div style="display:grid;grid-template-columns:20px 1fr 20px;align-items:center;gap:4px;margin-bottom:3px">'+
        '<span style="font-size:10px;color:var(--muted);text-align:right">'+k+'</span>'+
        '<div style="background:#eee;border-radius:3px;height:5px"><div style="width:'+pct+'%;background:'+col+';height:5px;border-radius:3px"></div></div>'+
        '<span style="font-size:10px;color:var(--muted)">'+v+'</span></div>';
    }
    nbars.innerHTML=bh;
  }
  // Comments
  const comments=nd2.comments||[];
  const ncomm=document.getElementById("ncomm");
  if(ncomm)ncomm.innerHTML=comments.slice(0,2).map(function(c){
    return'<tr><td><span style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--rf-l);font-size:11px;font-weight:700;color:var(--rf-d)">'+c.nota+'</span></td>'+
      '<td><span class="tag tag-rf">'+c.svc+'</span></td><td>'+c.txt+'</td><td style="color:var(--muted);white-space:nowrap">'+c.fecha+'</td></tr>';
  }).join("");
  // Chart
  if(cN)cN.destroy();
  var canvasEl=document.getElementById("ch-nps");
  if(canvasEl&&canvasEl.getContext){
  cN=new Chart(canvasEl,{type:"line",data:{labels:nd2.weekly.map(w=>w.w),datasets:[{data:nd2.weekly.map(w=>w.nps),borderColor:"#185FA5",backgroundColor:"rgba(24,95,165,0.08)",tension:0.4,fill:true,pointRadius:4,borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{min:0,max:100,ticks:{callback:v=>v+""}}}}});
  }
  // Comments table
  var cTbl=document.getElementById("nps-comments");
  if(cTbl){
    cTbl.innerHTML=nd2.comments.map(function(c){
      var col=c.nota>=9?"var(--rf-d)":c.nota>=7?"#BA7517":"#A32D2D";
      return'<tr style="border-bottom:1px solid var(--border)">'+
        '<td style="padding:5px 8px"><span style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--hover);font-size:11px;font-weight:700;color:'+col+'">'+c.nota+'</span></td>'+
        '<td style="padding:5px 8px;font-size:10px;color:var(--muted)">'+c.svc+'</td>'+
        '<td style="padding:5px 8px">'+c.txt+'</td>'+
        '<td style="padding:5px 8px;color:var(--muted);white-space:nowrap;font-size:10px">'+c.fecha+'</td></tr>';
    }).join("");
  }
}catch(e){console.error("renderNps error:",e,e.stack);}}

// ── populateDates ──────────────────────────────────────────────────
function populateDates(){
  const sf=document.getElementById("sf");const st=document.getElementById("st");
  if(!sf||!st)return;
  sf.innerHTML=st.innerHTML="";
  var datesForPicker=mes==="todos"?DATES:DATES.filter(function(d){return d.startsWith(mes);});
  datesForPicker.forEach(function(d){
    const p=d.split("-");const label=DL[d]+" "+p[2]+"/"+p[1]+(isProj(d)?" *":"");
    sf.innerHTML+='<option value="'+d+'"'+(d===fromD?" selected":"")+'>'+label+"</option>";
    st.innerHTML+='<option value="'+d+'"'+(d===toD?" selected":"")+'>'+label+"</option>";
  });
}


// ── renderStock ───────────────────────────────────────────────────────
function toggleStockCat(cid){
  var rows=document.querySelectorAll(".srow-"+cid);
  var isHidden=rows.length>0&&rows[0].style.display==="none";
  rows.forEach(function(r){r.style.display=isHidden?"table-row":"none";});
  var arrows=document.querySelectorAll(".cat-arrow-"+cid);
  arrows.forEach(function(a){a.textContent=isHidden?"\u25BC":"\u25BA";});
}

function renderStock(){
  var stockKpis  = document.getElementById("stock-kpis");
  var stockTbody = document.getElementById("stock-tbody");
  if(!stockTbody) return;

  var fd = DATES.filter(function(d){return d>=fromD&&d<=toD&&(mes==="todos"||d.startsWith(mes));});

  // ── Step 1: Compute sales per inventory product from ARI ──────────────
  // Only dates after the last physical count (2026-05-12)
  var salesByInv = {};  // inv_product_name → units sold
  fd.filter(function(d){return d>"2026-05-12";}).forEach(function(date){
    // Read IziPay ARI data for this date — but we need product-level, not category-level
    // ARI{} in the report has category totals. For per-SKU we need the PROD_MAP + ARI_SALES
    // ARI_SALES will be a new per-product sales dict we build below
    if(ARI_SALES[date]){
      Object.keys(ARI_SALES[date]).forEach(function(ariName){
        var qty = ARI_SALES[date][ariName];
        if(PROD_MAP[ariName]){
          var invName = PROD_MAP[ariName].inv;
          var unit    = PROD_MAP[ariName].unit||1;
          salesByInv[invName] = (salesByInv[invName]||0) + qty*unit;
        }
      });
    }
  });

  // ── Step 2: Build stock to-be per product ────────────────────────────
  // Find last physical count for each product
  var lastCount = {};  // inv_name → {qty, date}
  CONTEOS.forEach(function(c){
    if(c.date<=toD){
      if(!lastCount[c.prod]||c.date>lastCount[c.prod].date){
        lastCount[c.prod]={qty:c.qty,date:c.date,cat:c.cat,precio:c.precio};
      }
    }
  });

  // ── Step 3: Build category structure ─────────────────────────────────
  var cats = {};
  var CAT_ORDER = ["Bebidas","Implementos","Compass","Head"];
  CAT_ORDER.forEach(function(c){cats[c]={items:[],baseTotal:0,tobeTotal:0,valor:0,soldTotal:0};});

  Object.keys(lastCount).forEach(function(prod){
    var lc  = lastCount[prod];
    var cat = lc.cat;
    if(!cats[cat]) cats[cat]={items:[],baseTotal:0,tobeTotal:0,valor:0,soldTotal:0};
    var sold = Math.round((salesByInv[prod]||0)*10)/10;
    var tobe = Math.max(0, lc.qty - sold);
    var valor = tobe * lc.precio;
    cats[cat].items.push({prod:prod, base:lc.qty, sold:sold, tobe:tobe, precio:lc.precio, valor:valor});
    cats[cat].baseTotal  += lc.qty;
    cats[cat].soldTotal  += sold;
    cats[cat].tobeTotal  += tobe;
    cats[cat].valor      += valor;
  });

  // ── Step 4: 3 Coincidencia metrics (only when 2+ counts exist) ───────
  var countDates = [...new Set(CONTEOS.map(function(c){return c.date;}))].sort();
  var hasMultipleCounts = countDates.length >= 2;
  var ira = null, skuAcc = null, valAcc = null;
  var physCountDate = countDates.filter(function(d){return d<=toD&&d>"2026-05-12";});

  if(hasMultipleCounts && physCountDate.length > 0){
    var latestPhys = physCountDate[physCountDate.length-1];
    // Get physical counts for that date
    var physCounts = {};
    CONTEOS.filter(function(c){return c.date===latestPhys;}).forEach(function(c){
      physCounts[c.prod]=c.qty;
    });
    // Compare physical vs to-be
    var totalSKU=0, correctSKU=0, skuAccSum=0;
    var valPhys=0, valTobe=0;
    Object.keys(physCounts).forEach(function(prod){
      var phys = physCounts[prod];
      var lc   = lastCount[prod];
      if(!lc) return;
      var sold = salesByInv[prod]||0;
      var tobe = Math.max(0, lc.qty - sold);
      var tolerance = tobe < 10 ? 1 : Math.ceil(tobe*0.05);
      var diff = Math.abs(phys - tobe);
      totalSKU++;
      if(diff<=tolerance) correctSKU++;
      if(tobe>0) skuAccSum += Math.min(2, phys/tobe);  // cap at 200% to avoid outliers
      valPhys += phys * lc.precio;
      valTobe += tobe * lc.precio;
    });
    if(totalSKU>0){
      ira    = Math.round(correctSKU/totalSKU*100);
      skuAcc = Math.round(skuAccSum/totalSKU*100);
      valAcc = valTobe>0 ? Math.round(valPhys/valTobe*100) : null;
    }
  }

  // ── Step 5: KPIs ──────────────────────────────────────────────────────
  var totalBase=0,totalTobe=0,totalValor=0;
  Object.keys(cats).forEach(function(cat){
    totalBase +=cats[cat].baseTotal;
    totalTobe +=cats[cat].tobeTotal;
    totalValor+=cats[cat].valor;
  });

  var iraHtml = ira!==null ?
    '<div class="kpi '+(ira>=95?"green":ira>=80?"":"red")+'"><div class="kpi-lbl">IRA (inventory record accuracy)</div>'+
    '<div class="kpi-val">'+ira+'%</div><div class="kpi-sub">SKUs dentro de tolerancia &plusmn;5%</div></div>'+
    '<div class="kpi"><div class="kpi-lbl">SKU Accuracy</div>'+
    '<div class="kpi-val">'+skuAcc+'%</div><div class="kpi-sub">promedio f\xedsico/to-be por SKU</div></div>'+
    '<div class="kpi '+(valAcc>=95?"green":valAcc>=80?"":"red")+'"><div class="kpi-lbl">Value Accuracy</div>'+
    '<div class="kpi-val">'+valAcc+'%</div><div class="kpi-sub">valorizado f\xedsico/valorizado to-be</div></div>' :
    '<div class="kpi" style="grid-column:span 3;background:var(--hover);border:1px dashed var(--border)">'+
    '<div class="kpi-lbl" style="color:var(--muted)">Coincidencia de stock</div>'+
    '<div style="font-size:12px;color:var(--muted);margin-top:6px">IRA &middot; SKU Accuracy &middot; Value Accuracy disponibles en el pr\xf3ximo conteo f\xedsico quincenal</div></div>';

  if(stockKpis) stockKpis.innerHTML=
    '<div class="kpi"><div class="kpi-lbl">Unidades base</div><div class="kpi-val">'+totalBase+'</div>'+
    '<div class="kpi-sub">conteo f\xedsico '+countDates[0]+'</div></div>'+
    '<div class="kpi"><div class="kpi-lbl">Stock to-be</div><div class="kpi-val">'+totalTobe+'</div>'+
    '<div class="kpi-sub">base \u2212 ventas periodo</div></div>'+
    '<div class="kpi blue"><div class="kpi-lbl">Valorizado to-be</div><div class="kpi-val">'+fS(totalValor)+'</div>'+
    '<div class="kpi-sub">a precio de venta</div></div>'+
    iraHtml;

  // ── Step 6: Table ─────────────────────────────────────────────────────
  var catColors={"Bebidas":"#185FA5","Compass":"#8B5CF6","Head":"#DC2626","Implementos":"#D97706"};
  var rows="";
  CAT_ORDER.concat(Object.keys(cats).filter(function(c){return !CAT_ORDER.includes(c);})).forEach(function(cat){
    if(!cats[cat]||cats[cat].items.length===0) return;
    var c=cats[cat];
    var cid="sc"+cat.replace(/[^a-zA-Z]/g,"");
    var col=catColors[cat]||"var(--pa-d)";
    rows+="<tr style=\"background:var(--pa-l);cursor:pointer\" data-cat=\""+cid+"\" class=\"stock-cat-hdr\">"+
      "<td style=\"font-size:12px\" class=\"cat-arrow-"+cid+"\">\u25BA</td>"+
      "<td style=\"font-weight:700;font-size:12px;color:"+col+"\">"+cat+
        " <span style=\"font-weight:400;color:var(--muted);font-size:10px\">("+c.items.length+")</span></td>"+
      "<td style=\"text-align:right;font-weight:700;font-size:12px\">"+c.baseTotal+"</td>"+
      "<td style=\"text-align:right;font-size:11px;color:var(--muted)\">"+Math.round(c.soldTotal)+"</td>"+
      "<td style=\"text-align:right;font-weight:700;font-size:12px;color:"+col+"\">"+Math.round(c.tobeTotal)+"</td>"+
      "<td></td>"+
      "<td style=\"text-align:right;font-weight:700;font-size:12px\">"+fS(c.valor)+"</td>"+
    "</tr>";
    c.items.sort(function(a,b){return a.prod.localeCompare(b.prod);}).forEach(function(item){
      var alert=item.tobe<=0?" style=\"background:#FFF0F0\"":"";
      rows+="<tr class=\"srow-"+cid+"\" style=\"display:none\""+alert+">"+
        "<td></td>"+
        "<td style=\"font-size:11px;padding-left:18px\">"+item.prod+"</td>"+
        "<td style=\"text-align:right;font-size:11px\">"+item.base+"</td>"+
        "<td style=\"text-align:right;font-size:11px;color:var(--muted)\">"+
          (item.sold>0?"~"+Math.round(item.sold*10)/10:"\u2014")+"</td>"+
        "<td style=\"text-align:right;font-size:11px;font-weight:600;color:"+
          (item.tobe<=0?"#A32D2D":"var(--text)")+"\">"+Math.round(item.tobe)+"</td>"+
        "<td style=\"text-align:right;font-size:11px;color:var(--muted)\">S/"+item.precio.toFixed(2)+"</td>"+
        "<td style=\"text-align:right;font-size:11px\">"+fS(item.valor)+"</td>"+
      "</tr>";
    });
  });
  stockTbody.innerHTML=rows;
  stockTbody.addEventListener("click",function(e){
    var hdr=e.target.closest(".stock-cat-hdr");
    if(hdr)toggleStockCat(hdr.dataset.cat);
  });
}

document.addEventListener("DOMContentLoaded",function(){
  populateDates();
  document.getElementById("seg-emp").addEventListener("click",function(e){
    if(e.target.dataset.v){emp=e.target.dataset.v;document.querySelectorAll("#seg-emp button").forEach(b=>b.classList.toggle("on",b.dataset.v===emp));render();renderStock();}
  });
  document.getElementById("sf").addEventListener("change",function(e){fromD=e.target.value;render();renderStock();});
  document.getElementById("st").addEventListener("change",function(e){toD=e.target.value;render();renderStock();});
  document.getElementById("bc").addEventListener("click",function(){fromD=DATES[0];toD=DATES[DATES.length-1];document.getElementById("sf").selectedIndex=0;document.getElementById("st").selectedIndex=DATES.length-1;render();});
  var segMes=document.getElementById("seg-mes");
  if(segMes)segMes.addEventListener("click",function(e){
    if(e.target.dataset.v){
      mes=e.target.dataset.v;
      document.querySelectorAll("#seg-mes button").forEach(b=>b.classList.toggle("on",b.dataset.v===mes));
      // Update date range to match month
      if(mes==="todos"){fromD=DATES[0];toD=DATES[DATES.length-1];}
      else{
        var md=DATES.filter(d=>d.startsWith(mes));
        if(md.length){fromD=md[0];toD=md[md.length-1];}
      }
      populateDates();render();renderStock();
    }
  });
  var ntabsEl=document.getElementById("ntabs");
  if(ntabsEl)ntabsEl.addEventListener("click",function(e){
    if(e.target.dataset.v){nE=e.target.dataset.v;document.querySelectorAll("#ntabs button").forEach(b=>b.classList.toggle("on",b.dataset.v===nE));renderNps();}
  });
  render();renderNps();renderStock();
  var sb=document.getElementById("js-status");if(sb)sb.style.display="block";
});





  // Global toggle for egresos rows
  if(typeof window.toggleGastoRow==='undefined'){
    window.toggleGastoRow=function(id){var el=document.getElementById(id);if(el)el.style.display=el.style.display===''?'none':'';};
  }


